      {
        "name": "anime_genres",
        "lineageTag": "1325ea6f-2634-2607-d6a2-ba0e1819d3de",
        "columns": [
          {
            "name": "anime_id",
            "dataType": "int64",
            "sourceColumn": "anime_id",
            "lineageTag": "c8f38273-89b5-4c1e-4bb8-6f3a99fae49b",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "0"
          },
          {
            "name": "genre",
            "dataType": "string",
            "sourceColumn": "genre",
            "lineageTag": "8463ea0c-003a-17ee-f5c6-63ba5fae37ee",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Genre Tags",
            "expression": "COUNTROWS(anime_genres)",
            "formatString": "#,0",
            "lineageTag": "8fd39b33-25bb-d595-69d9-729597d6d6cf"
          }
        ],
        "partitions": [
          {
            "name": "anime_genres",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = AnimeClean,",
                "    GenreSource = Table.SelectColumns(Source, {\"anime_id\", \"genres\"}),",
                "    SplitToList = Table.TransformColumns(GenreSource, {{\"genres\", each Text.Split(_, \", \")}}),",
                "    ExpandedRows = Table.ExpandListColumn(SplitToList, \"genres\"),",
                "    Renamed = Table.RenameColumns(ExpandedRows, {{\"genres\", \"genre\"}}),",
                "    Typed = Table.TransformColumnTypes(Renamed, {{\"anime_id\", Int64.Type}, {\"genre\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "84826410-e290-f162-92ec-7b59200a3a47",
        "fromTable": "anime_genres",
        "fromColumn": "anime_id",
        "toTable": "anime",
        "toColumn": "anime_id",
        "crossFilteringBehavior": "bothDirections"
      }
    ],
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"D:\\DVT\\Exp-6b\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "eca07335-a33c-5aeb-5e1b-c7c98b4b9d80",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "AnimeClean",
        "kind": "m",
        "expression": [
          "let",
          "    Source = Csv.Document(File.Contents(DataFolder & \"popular_anime.csv\"), [Delimiter=\",\", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
          "    RemovedColumns = Table.RemoveColumns(PromotedHeaders, {\"producers\", \"image\", \"trailer\", \"synopsis\"}),",
          "    BlanksToNull = Table.ReplaceValue(RemovedColumns, \"\", null, Replacer.ReplaceValue, {\"genres\", \"type\", \"episodes\", \"aired_from\", \"aired_to\", \"score\", \"scored_by\", \"rank\", \"rating\", \"studios\"}),",
          "    ChangedType = Table.TransformColumnTypes(BlanksToNull, {{\"id\", Int64.Type}, {\"name\", type text}, {\"episodes\", type number}, {\"score\", type number}, {\"scored_by\", type number}, {\"rank\", type number}}, \"en-US\"),",
          "    RemovedDuplicates = Table.Distinct(ChangedType, {\"id\"}),",
          "    RemovedAdult = Table.SelectRows(RemovedDuplicates, each [rating] <> \"Rx - Hentai\" and not Text.Contains(if [genres] = null then \"\" else [genres], \"Hentai\") and not Text.Contains(if [genres] = null then \"\" else [genres], \"Erotica\")),",
          "    RemovedBlankType = Table.SelectRows(RemovedAdult, each [type] <> null),",
          "    TrimmedText = Table.TransformColumns(RemovedBlankType, {{\"name\", Text.Trim, type text}, {\"duration_per_ep\", Text.Trim, type text}}),",
          "    ParsedDates = Table.TransformColumns(TrimmedText, {{\"aired_from\", each if _ = null then null else Date.FromText(Text.Start(_, 10)), type date}, {\"aired_to\", each if _ = null then null else Date.FromText(Text.Start(_, 10)), type date}}),",
          "    AddedYear = Table.AddColumn(ParsedDates, \"year\", each if [aired_from] = null then null else Date.Year([aired_from]), Int64.Type),",
          "    AddedDecade = Table.AddColumn(AddedYear, \"decade\", each if [year] = null then \"Unknown\" else Text.From(Number.IntegerDivide([year], 10) * 10) & \"s\", type text),",
          "    AddedDuration = Table.AddColumn(AddedDecade, \"duration_min\", each let t = Text.Replace([duration_per_ep], \" per ep\", \"\"), w = Text.Split(t, \" \"),",
          "            hr = if List.Contains(w, \"hr\") then Number.From(w{List.PositionOf(w, \"hr\") - 1}) else 0,",
          "            mn = if List.Contains(w, \"min\") then Number.From(w{List.PositionOf(w, \"min\") - 1}) else 0,",
          "            sc = if List.Contains(w, \"sec\") then Number.From(w{List.PositionOf(w, \"sec\") - 1}) else 0",
          "        in if t = \"Unknown\" then null else hr * 60 + mn + sc / 60, type number),",
          "    FilledEpisodes = Table.ReplaceValue(AddedDuration, null, 1, Replacer.ReplaceValue, {\"episodes\"}),",
          "    AddedRuntime = Table.AddColumn(FilledEpisodes, \"total_hours\", each if [duration_min] = null then null else Number.Round([episodes] * [duration_min] / 60, 2), type number),",
          "    AgeRating = Table.AddColumn(AddedRuntime, \"age_rating\", each if [rating] = null then \"PG-13\" else Text.BeforeDelimiter([rating], \" - \"), type text),",
          "    MainStudio = Table.AddColumn(AgeRating, \"main_studio\", each if [studios] = null then \"Unknown\" else Text.BeforeDelimiter([studios], \", \"), type text),",
          "    GenresFilled = Table.ReplaceValue(MainStudio, null, \"Unknown\", Replacer.ReplaceValue, {\"genres\"}),",
          "    ScoreBand = Table.AddColumn(GenresFilled, \"score_band\", each if [score] = null then \"Not Rated\" else if [score] >= 8 then \"Excellent (8+)\" else if [score] >= 7 then \"Very Good (7-8)\" else if [score] >= 6 then \"Good (6-7)\" else if [score] >= 5 then \"Average (5-6)\" else \"Poor (<5)\", type text),",
          "    Renamed = Table.RenameColumns(ScoreBand, {{\"id\", \"anime_id\"}, {\"name\", \"title\"}, {\"scored_by\", \"members_scored\"}, {\"aired_from\", \"start_date\"}, {\"aired_to\", \"end_date\"}})",
          "in",
          "    Renamed"
        ],
        "lineageTag": "05e7323c-540e-ca71-6bce-cb63897bd821",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataFolder\", \"AnimeClean\", \"anime\", \"anime_genres\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBIDesktopVersion",
        "value": "2.157.151.0"
      }
    ]
  }
}
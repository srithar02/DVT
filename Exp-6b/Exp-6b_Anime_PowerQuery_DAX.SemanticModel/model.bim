        "measures": [
          {
            "name": "Total Titles",
            "expression": "COUNTROWS(anime)",
            "formatString": "#,0",
            "lineageTag": "a0295d3d-3361-40f6-eca4-9b4d98f1e787"
          },
          {
            "name": "Scored Titles",
            "expression": "CALCULATE(COUNTROWS(anime), NOT ISBLANK(anime[score]))",
            "formatString": "#,0",
            "lineageTag": "a46e043d-5b42-6091-2149-7ab82506c063"
          },
          {
            "name": "Average Score",
            "expression": "AVERAGE(anime[score])",
            "formatString": "0.00",
            "lineageTag": "2114a066-0657-e815-335c-7dfd2d41c50f"
          },
          {
            "name": "Highest Score",
            "expression": "MAX(anime[score])",
            "formatString": "0.00",
            "lineageTag": "f3b4ec1d-0028-cb33-108d-f4c136d5299c"
          },
          {
            "name": "Total Members",
            "expression": "SUM(anime[members_scored])",
            "formatString": "#,0",
            "lineageTag": "433c6843-53b9-53e0-5e5d-0938a517877c"
          },
          {
            "name": "High Rated Titles",
            "expression": "CALCULATE(COUNTROWS(anime), anime[score] >= 8)",
            "formatString": "#,0",
            "lineageTag": "f11ef784-f14e-8d60-78ce-4d3edae8e67b"
          },
          {
            "name": "% Rated",
            "expression": "DIVIDE([Scored Titles], [Total Titles])",
            "formatString": "0.0%",
            "lineageTag": "0e9a04f0-032b-48d5-7923-bc752e2a6e4d"
          },
          {
            "name": "Avg Episodes",
            "expression": "AVERAGE(anime[episodes])",
            "formatString": "0.0",
            "lineageTag": "b6f16ecb-fb4f-25b3-dff4-aff9c774eeb7"
          },
          {
            "name": "Total Runtime Hours",
            "expression": "SUM(anime[total_hours])",
            "formatString": "#,0",
            "lineageTag": "f9116c53-96bd-7f17-4630-2abd977ca3c5"
          },
          {
            "name": "Avg Members per Title",
            "expression": "DIVIDE([Total Members], [Scored Titles])",
            "formatString": "#,0",
            "lineageTag": "aff298a5-1c4a-9a6c-3af3-8910926c9b31"
          },
          {
            "name": "Weighted Avg Score",
            "expression": "DIVIDE(SUMX(anime, anime[score] * anime[members_scored]), [Total Members])",
            "formatString": "0.00",
            "lineageTag": "3fbf4aab-fe78-620b-3b13-6dab3181b57f"
          },
          {
            "name": "Currently Airing",
            "expression": "CALCULATE(COUNTROWS(anime), anime[status] = \"Currently Airing\")",
            "formatString": "#,0",
            "lineageTag": "38388ca1-c9b9-29fc-e5c4-e0ca5fe0f1fe"
          }
        ],
        "partitions": [
          {
            "name": "anime",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = AnimeClean,",
                "    SelectedColumns = Table.SelectColumns(Source, {\"anime_id\", \"title\", \"type\", \"episodes\", \"status\", \"start_date\", \"end_date\", \"score\", \"members_scored\", \"rank\", \"year\", \"decade\", \"duration_min\", \"total_hours\", \"age_rating\", \"main_studio\", \"score_band\"})",
                "in",
                "    SelectedColumns"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
